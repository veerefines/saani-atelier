# Copy this file to .env.local and fill it in. Never commit .env.local.

# Long random string used to sign login cookies. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Invite codes. One entry per person. role is "saanika" or "wellwisher".
# In development, if this is empty, two demo codes work: DEMO-SAANIKA and DEMO-FRIEND.
# In production this MUST be set. Remove a person here to revoke their link.
INVITES=[{"id":"saanika","name":"Saanika","role":"saanika","code":"CHANGE-ME-1"},{"id":"priya","name":"Priya","role":"wellwisher","code":"CHANGE-ME-2"}]

# Storage for the real site (leave empty on your Mac to store things in ./.data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: live Google ratings in Milano corner's "Surprise me" cards.
# A Google Cloud key with the Places API (New) enabled. Without it, cards link to Google Maps instead.
GOOGLE_MAPS_API_KEY=

# Optional: Google Search for Jelly, through Gemini (free key from aistudio.google.com/apikey).
# Without it Jelly answers from what she knows.
GEMINI_API_KEY=
